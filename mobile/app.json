{
  "expo": {
    "name": "ANDERGO Play",
    "slug": "andergo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/andergo-app-icon.png",
    "scheme": "andergo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/andergo-app-icon.png",
      "bundleIdentifier": "online.andergo.academy"
    },
    "android": {
      "package": "online.andergo.academy",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/andergo-app-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/andergo-app-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite que ANDERGO Play use el micrófono para practicar idiomas con el Tutor.",
          "speechRecognitionPermission": "Permite que ANDERGO Play convierta tu voz en texto durante la práctica."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d9dfa33-5b67-4823-a030-ffa4ca5cf3e6"
      }
    },
    "owner": "andergo_app"
  }
}
