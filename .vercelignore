# Local mobile build caches are neither web assets nor deployment inputs.
# Gradle holds these files open while Android Studio is running, which would
# otherwise prevent Vercel from packaging the static web application.
mobile/android/.gradle/
mobile/android/build/
mobile/.expo/
mobile/node_modules/

# Local worktrees, authoring caches and corpus downloads are not web inputs.
# Keeping them out of the upload also avoids Vercel's single-file size limit.
.deploy-worktree/
.poster-worktree/
.reading-cache-worktree/
.vocab-minimum-worktree/
tmp/
